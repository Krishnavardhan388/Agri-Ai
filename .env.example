# ==============================================================================
# AGRI AI — Real-Time Production Environment Configuration
# Copy to `.env` for local backend OR set these keys in Vercel Environment Variables
# ==============================================================================

# 1. MongoDB Atlas Cloud Connection (https://cloud.mongodb.com -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agri_ai

# 2. Fast2SMS Real OTP SMS Gateway (https://www.fast2sms.com -> Dev API)
FAST2SMS_API_KEY=
# Options: "q" (Quick SMS MVP), "otp_send" (/dev/otp/send Smart OTP), or "dlt"
FAST2SMS_ROUTE=q
FAST2SMS_OTP_ID=
FAST2SMS_SENDER_ID=AGRIAI
FAST2SMS_DLT_TEMPLATE_ID=

# 3. Session Signing Secret (set a strong random string in Vercel)
AUTH_SECRET_KEY=agri-ai-startup-production-secret-2026

# 4. Optional: Google Gemini API Key (for Live Plant Vision & AGRI MITRA Voice)
GEMINI_API_KEY=
